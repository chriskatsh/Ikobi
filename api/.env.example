# --- Général
NODE_ENV=production
PORT=3000
# URL publique de l'API (sert à construire l'URL de callback MOKO)
PUBLIC_URL=https://api.ikobi.app
JWT_SECRET=          # chaîne aléatoire longue (64+ caractères)
OTP_SECRET=          # autre chaîne aléatoire longue
OTP_DEBUG=0

# --- Base MySQL Hostinger (depuis l'app : toujours 127.0.0.1)
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- MOKO Afrika (fourni par MOKO)
MOKO_BASE_URL=https://paydrc.gofreshbakery.net/api/v5
MOKO_MERCHANT_ID=
MOKO_MERCHANT_SECRET=
MOKO_AES_KEY=        # clé de chiffrement des callbacks (16/24/32 caractères)
MOKO_AES_IV=         # laisser vide si MOKO utilise la clé comme IV
MOKO_HMAC_KEY=       # clé de signature X-Signature
MOKO_DEFAULT_EMAIL=paiements@ikobi.app

# --- WhatsApp Cloud API (Meta) — numéro WhatsApp Business d'Ikobi
WA_GRAPH_VERSION=v21.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=     # jeton d'utilisateur système (permanent)
WA_APP_SECRET=       # secret de l'app Meta (signature des webhooks)
WA_VERIFY_TOKEN=     # chaîne de votre choix, à recopier dans Meta
WA_BOT_NUMBER=+243XXXXXXXXX
WA_OTP_TEMPLATE=ikobi_code
WA_REMINDER_TEMPLATE=ikobi_rappel
WA_TEMPLATE_LANG=fr

# --- Fonctionnement
PAYOUT_MODE=manual   # manual (l'admin verse) | auto
REMINDERS_ENABLED=1
APP_STORE_URL=
PLAY_STORE_URL=
