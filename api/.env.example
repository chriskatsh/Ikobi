# --- Général
NODE_ENV=production
PORT=3000
# URL publique de l'API (sert à construire l'URL de callback MOKO)
PUBLIC_URL=https://api.ikobi.app
JWT_SECRET=          # chaîne aléatoire longue (64+ caractères)
OTP_SECRET=          # autre chaîne aléatoire longue
OTP_DEBUG=0

# --- Base MySQL Hostinger (depuis l'app : toujours 127.0.0.1)
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- AWA Network (fourni par AWA) — https://docs.awanetwork.tech
AWA_BASE_URL=https://api.awanetwork.tech
AWA_PUBLIC_ID=
AWA_MERCHANT_ID=
AWA_SECRET_KEY=
# Optionnel : surcharge des identifiants opérateurs si AWA en communique d'autres
# AWA_PROVIDER_IDS={"orange":2013,"airtel":2014,"africell":2015,"mpesa":2071}

# --- WhatsApp Cloud API (Meta) — numéro WhatsApp Business d'Ikobi
WA_GRAPH_VERSION=v21.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=     # jeton d'utilisateur système (permanent)
WA_APP_SECRET=       # secret de l'app Meta (signature des webhooks)
WA_VERIFY_TOKEN=     # chaîne de votre choix, à recopier dans Meta
WA_BOT_NUMBER=+243XXXXXXXXX
WA_OTP_TEMPLATE=ikobi_code
WA_REMINDER_TEMPLATE=ikobi_rappel
WA_TEMPLATE_LANG=fr

# --- Fonctionnement
REQUIRE_SETTLEMENT_BEFORE_PAYOUT=1
PLATFORM_ADMIN_PHONES=   # ex. 243812345678 (rôle admin plateforme à la connexion)
REMINDERS_ENABLED=1
APP_STORE_URL=
PLAY_STORE_URL=
